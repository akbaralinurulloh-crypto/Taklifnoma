# Faqat o'zgaruvchi nomlari. Haqiqiy qiymatlarni .env.local fayliga yozing va hech qachon repositoryga qo'shmang.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Faqat server uchun. NEXT_PUBLIC_ prefiksi bilan ATAMANG.
SUPABASE_SERVICE_ROLE_KEY=
# Ommaviy havolalar uchun asosiy manzil (masalan https://sayt-domeni.uz)
NEXT_PUBLIC_SITE_URL=
# Admin panelga kirish uchun server tomonidagi maxfiy qiymat
ADMIN_SECRET=
# Ixtiyoriy: bosh sahifadagi aloqa bo'limi uchun elektron pochta
NEXT_PUBLIC_CONTACT_EMAIL=
